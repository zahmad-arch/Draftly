# ── AI drafting ──────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# Without it, the app runs in demo mode (templated sample proposals).
ANTHROPIC_API_KEY=

# ── Payments (Stripe) ────────────────────────────────────────
# https://dashboard.stripe.com/apikeys (use test keys first).
STRIPE_SECRET_KEY=
# From the webhook endpoint you create at https://dashboard.stripe.com/webhooks
# (event: checkout.session.completed + customer.subscription.*). Starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# ── Auth + database (Supabase) ───────────────────────────────
# Project URL + keys from https://supabase.com/dashboard → Project Settings → API.
# Without these, the app runs open (no login, studio ungated) for local dev.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (new) — legacy projects can use the anon key via
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead; either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key — SERVER ONLY, used by the Stripe webhook to write
# subscription state. Never expose this to the browser. Legacy name:
# SUPABASE_SERVICE_ROLE_KEY (either works).
SUPABASE_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────
# Canonical site origin, used to build email-confirmation links. On Vercel this
# is inferred from request headers, so it's only needed for custom setups.
NEXT_PUBLIC_SITE_URL=
